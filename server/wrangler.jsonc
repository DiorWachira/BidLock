// The BidLock room server: one Cloudflare Worker, one Durable Object per room code.
// Deploy from the repo root with:  npx wrangler deploy --config server/wrangler.jsonc
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bidlock-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects: the kind the Workers Free plan includes.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // Web pages allowed to open rooms (comma separated). localhost on any port is
    // always allowed, for development and the tests.
    "ALLOWED_ORIGINS": "https://diorwachira.github.io"
  },
  "observability": { "enabled": true }
}
